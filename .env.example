# Required to sign in at /admin
# Choose a long, unique password. Do not commit the real value.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional. Used in sitemap and Open Graph URLs.
# After deploying to Vercel, set this to https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. If set, the contact form POSTs here instead of opening mailto.
# Example: https://formspree.io/f/xxxxxxxx
# You can also set this from /admin (Contact → Formspree endpoint).
# FORMSPREE_ENDPOINT=

# Optional. Persist /admin edits on the live Vercel site by committing content/site.json.
# Create a GitHub fine-grained token with Contents: Read and write for this repo.
# GITHUB_TOKEN=
# GITHUB_REPO=khs976-dot/legal-
# GITHUB_BRANCH=main
