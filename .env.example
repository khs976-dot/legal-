# Required to sign in at /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional. Used in sitemap and Open Graph URLs for local or later preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Intake form destination. Defaults to this address if unset.
CONTACT_TO_EMAIL=khs.976@outlook.com

# Optional. Send intake mail automatically (free Resend sandbox).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=لوحة الطلب <onboarding@resend.dev>

# Optional free form backend (Web3Forms or Formspree free tier).
# If neither Resend nor an endpoint is set, the site uses mailto: — no paid plan.
# Web3Forms free: ~250 submissions/month.
#   CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
#   CONTACT_FORM_ACCESS_KEY=your-free-access-key
# Formspree free: ~50 submissions/month.
#   CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
