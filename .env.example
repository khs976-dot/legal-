# Required to sign in at /admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional. Used in sitemap and Open Graph URLs for local preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Intake destination. Defaults to this address if unset.
CONTACT_TO_EMAIL=khs.976@outlook.com

# Optional free form backend (no paid plan, no credit card required).
# If unset, the site uses mailto: plus copy-to-clipboard.
# Web3Forms free: about 250 submissions/month.
#   CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
#   CONTACT_FORM_ACCESS_KEY=your-free-access-key
# Formspree free: about 50 submissions/month.
#   CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
